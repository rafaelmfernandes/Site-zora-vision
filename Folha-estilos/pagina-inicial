* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #f1efe8;
    color: #2c2c2a;
  }

  /* Topo fixo */
  .topo {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background-color: #ffffff;
    border-bottom: 1px solid #e0ded6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    z-index: 1000;
  }

  .logo {
    font-size: 18px;
    font-weight: 700;
    color: #2c2c2a;
    white-space: nowrap;
  }

  .direita {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-pesquisar,
  .btn-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #d3d1c7;
    background-color: #fff;
    cursor: pointer;
    flex-shrink: 0;
  }

  .btn-pesquisar svg,
  .btn-menu svg {
    width: 18px;
    height: 18px;
    stroke: #444441;
  }

  /* Menu de navegação (mobile) */
  .nav-links {
    list-style: none;
    position: fixed;
    top: 60px;
    left: 0;
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid #e0ded6;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
    z-index: 999;
  }

  .nav-links.aberto {
    max-height: 240px;
  }

  .nav-links a {
    display: block;
    padding: 14px 16px;
    text-decoration: none;
    color: #444441;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 1px solid #f1efe8;
  }

  /* Barra de pesquisa */
  .barra-pesquisa {
    position: fixed;
    top: 60px;
    left: 0;
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid #e0ded6;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.25s ease, padding 0.25s ease;
    z-index: 999;
  }

  .barra-pesquisa.aberta {
    max-height: 70px;
    padding: 12px 16px;
  }

  .barra-pesquisa form {
    display: flex;
    align-items: center;
  }

  .barra-pesquisa input {
    flex: 1;
    height: 38px;
    padding: 0 12px;
    border: 1px solid #d3d1c7;
    border-radius: 8px 0 0 8px;
    border-right: none;
    font-size: 14px;
    font-family: inherit;
  }

  .barra-pesquisa input:focus {
    outline: none;
    border-color: #888780;
  }

  .barra-pesquisa button {
    height: 38px;
    padding: 0 16px;
    border: 1px solid #2c2c2a;
    background-color: #2c2c2a;
    color: #fff;
    border-radius: 0 8px 8px 0;
    font-size: 13px;
    cursor: pointer;
  }

  /* Conteúdo abaixo do topo fixo */
  .conteudo {
    margin-top: 60px;
    padding: 20px 16px 40px;
  }

  .banner {
    height: 180px;
    background-color: #d3d1c7;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5f5e5a;
    font-size: 14px;
    text-align: center;
    padding: 0 16px;
  }

  /* Seção de produtos */
  .secao-produtos {
    margin-top: 28px;
  }

  .secao-produtos h2 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .grade-produtos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .produto-card {
    background-color: #ffffff;
    border: 1px solid #e0ded6;
    border-radius: 10px;
    overflow: hidden;
  }

  .produto-imagem {
    width: 100%;
    height: 110px;
    background-color: #eae8e0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #b4b2a9;
    font-size: 12px;
  }

  .produto-info {
    padding: 10px;
  }

  .produto-nome {
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .produto-preco {
    font-size: 14px;
    font-weight: 700;
    color: #2c2c2a;
  }

  /* A partir daqui, ajustes para telas maiores (tablet/desktop) */
  @media (min-width: 700px) {
    .topo {
      height: 64px;
      padding: 0 24px;
    }

    .btn-menu {
      display: none;
    }

    .nav-links {
      position: static;
      display: flex;
      align-items: center;
      gap: 24px;
      max-height: none;
      overflow: visible;
      width: auto;
      background: none;
      border: none;
    }

    .nav-links a {
      padding: 0;
      border: none;
    }

    .barra-pesquisa {
      top: 64px;
    }

    .conteudo {
      margin-top: 64px;
      padding: 40px 24px;
    }

    .banner {
      height: 260px;
    }

    .grade-produtos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }